# Google Maps API Key (REQUIRED)
# Get your API key from: https://console.cloud.google.com/apis/credentials
GOOGLE_MAPS_API_KEY=your_api_key_here

# Yelp API Key (optional but highly recommended)
# Get your API key from: https://www.yelp.com/developers/v3/manage_app
YELP_API_KEY=your_yelp_api_key_here

# HunterIO API Key (optional - for email validation & finding)
# Get your API key from: https://hunter.io/api
# Free tier: 25 searches/month
HUNTER_API_KEY=your_hunter_api_key_here

# ZeroBounce API Key (optional - for email verification)
# Get your API key from: https://www.zerobounce.net/
# Free tier: 100 validations/month
ZEROBOUNCE_API_KEY=your_zerobounce_api_key_here

# HubSpot API Key (optional - for direct CRM integration)
# Get your API key from: https://app.hubspot.com/
HUBSPOT_API_KEY=your_hubspot_api_key_here

# Optional: User agent for web scraping
USER_AGENT=Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36
